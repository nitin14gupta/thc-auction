[Unit]
Description=HYPE Auction API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/thc-auction/server
EnvironmentFile=/var/www/thc-auction/server/.env
ExecStart=/var/www/thc-auction/server/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
