[Unit]
Description=HYPE Auction activity simulator (users/listings/bids)
After=network.target thc-auction-api.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/var/www/thc-auction/server
EnvironmentFile=/var/www/thc-auction/server/.env
ExecStart=/var/www/thc-auction/server/venv/bin/python scripts/simulate_activity.py
